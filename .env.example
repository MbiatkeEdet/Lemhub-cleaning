VITE_API_BASE_URL=http://localhost:8000/api/v1
# Optional: Google OAuth client ID for "Sign in with Google". The button is
# hidden and email-OTP login still works fully if this is left unset.
VITE_GOOGLE_CLIENT_ID=
# Must match the backend's VAPID_PUBLIC_KEY (see backend/.env.example) — the
# cleaner "notify me" opt-in is hidden if this is left unset.
VITE_VAPID_PUBLIC_KEY=
